{
  "name": "sql-playground",
  "version": "1.0.0",
  "description": "Offline SQL Playground with SQLite",
  "main": "electron-main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --linux --win",
    "build:linux": "electron-builder --linux",
    "build:win": "electron-builder --win"
  },
  "build": {
    "appId": "sql-playground",
    "productName": "SQL Playground",
    "files": [
      "electron-main.js",
      "package.json",
      "index.html",
      "style.css",
      "app.js",
      "lint.js",
      "sql-wasm.js",
      "sql-wasm.wasm"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development"
    },
    "win": {
      "target": [
        "portable",
        "nsis"
      ]
    }
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  }
}
